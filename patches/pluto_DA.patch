+void customScheduling(PlutoProg *prog){
+    Stmt **stmts = prog->stmts;
+    Dep **deps = prog->deps;
+
+    printf("//----------------- Edit ----------------//\n");
+
+    FILE* fp = fopen(".trans", "r");
+    if (fp == NULL) {
+        printf("Cannot find .trans file\n");
+        return;
+    }
+
+    char buffer[255], temp[10], vals[255];
+    memset(vals, 0, sizeof(vals));
+
+    printf("Loading .trans file: \n");
+    int nrows = 0, ncols = 0, tp = 0, vp = 0;
+    while(!feof(fp)){
+
+        
+        memset(buffer, 0, sizeof(buffer));
+        memset(temp, 0, sizeof(temp));
+        fgets(buffer, 255, fp);
+
+        int len = strlen(buffer);
+        if(!len) continue;
+
+        printf("buffer:\n");
+        for(int i = 0; i < len; i++)
+            printf("%c", buffer[i]);
+
+        nrows++;
+        ncols = 0;
+        for(int i = 0; i <= len; i++){
+            if(i == len || (!isdigit(buffer[i]) && buffer[i] != '-')){
+                if(!tp) continue;
+                vals[vp++] = atoi(temp);
+                memset(temp, 0, sizeof(temp));
+                tp = 0;
+                ncols++;
+            }
+            else
+                temp[tp++] = buffer[i];
+        }  
+    }
+
+    // for debug
+    printf("nrows = %d, ncols = %d\n", nrows, ncols);
+    printf("The assigned trans matrix:\n");
+    for(int i = 0; i < nrows; i++){
+        for(int j = 0; j < ncols; j++)
+            printf("%d ", vals[i*ncols+j]);
+        printf("\n");
+    }
+        
+    printf("buffer vals:\n");
+    for(int i = 0; i < vp; i++)
+        printf("%d ", vals[i]);
+    printf("\n");
+    
+    for(int i = 0; i < nrows ; i++) // the upper bound should be divided by 2 if number of stmt is 2
+        for(int j = 0; j < ncols; j++)
+            stmts[0]->trans->val[i][j] = vals[i*ncols+j];
+    
+    // for(int i = nrows / 2; i < nrows; i++)
+    //     for(int j = 0; j < ncols; j++)
+    //         stmts[1]->trans->val[i - nrows / 2][j] = vals[i*ncols+j];
+
+    fclose(fp);
+
+    printf("//----------------- Edit ----------------//\n");
+}
